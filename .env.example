# Environment template.
#
# Copy to .env and replace every placeholder with a real value:
#   cp .env.example .env
#
# .env is gitignored and must never be committed. This file holds placeholders
# only — do not put real keys or passwords here.

# --- PostgreSQL -------------------------------------------------------------
# POSTGRES_HOST is the service name on the compose network, not localhost.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=crypto
POSTGRES_PASSWORD=change_me
POSTGRES_DB=crypto_rag
# Host port the database is published on. Kept separate from POSTGRES_PORT so
# the in-container port and the host mapping can differ (e.g. when a local
# Postgres already owns 5432).
POSTGRES_HOST_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key

# Embedding model used for news vectors. EMBEDDING_DIMENSIONS must match the
# vector(N) width in bdd/schema.sql — changing the model means a schema change
# and re-embedding every article, so settle this before the schema lands.
#   text-embedding-3-small  -> 1536  (OpenAI, better retrieval, small cost)
#   all-MiniLM-L6-v2        -> 384   (local, free, fully reproducible)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Model used to generate answers in the RAG endpoint.
LLM_MODEL=gpt-4o-mini

# --- CoinGecko --------------------------------------------------------------
# Optional — leave EMPTY to use the free public tier, which needs no key.
# Supplying a non-empty but invalid value is worse than supplying nothing: the
# endpoint is public without a key, but rejects a bad one with HTTP 401. The
# collectors therefore ignore any value still starting with "your_".
COINGECKO_API_KEY=

# --- Scraper microservice (internal) ----------------------------------------
SCRAPER_SERVICE_URL=http://scraper:8001/scrape
HEADLESS_BOOL=True

# --- Fear & Greed Index -----------------------------------------------------
# Public endpoint, no API key required.
FEAR_GREED_API_URL=https://api.alternative.me/fng/

# --- Collector intervals (seconds) ------------------------------------------
#
# Comments MUST be on their own line. Docker's --env-file and compose's
# `env_file:` parse literally and do not strip a trailing "# comment", so
# `PRICE_FETCH_INTERVAL=300  # 5 minutes` reaches the container as the string
# "300  # 5 minutes". Shells and python-dotenv do strip it, which makes the bug
# appear only inside Docker.

# 5 minutes
PRICE_FETCH_INTERVAL=300
# 15 minutes
NEWS_FETCH_INTERVAL=900
# 6 hours; the index itself only updates once a day
SENTIMENT_FETCH_INTERVAL=21600

# Set to any non-empty value to make a collector run a single cycle and exit,
# instead of looping. Leave empty in normal operation; used for testing so a
# 6-hour interval does not have to be waited out.
RUN_ONCE=

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO

# --- Grafana ----------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me

# --- Frontend ---------------------------------------------------------------
# Read by Vite at build time; must be reachable from the browser, so this is a
# host address rather than a compose service name.
VITE_API_URL=http://localhost:8000

# --- Environment ------------------------------------------------------------
# true for development, false for production.
DEBUG=true
