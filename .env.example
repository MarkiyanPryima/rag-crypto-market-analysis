# Environment template. Copy to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored and must never be committed.
#
# Comments MUST be on their own line: compose's env_file does not strip a
# trailing "# comment", so it would become part of the value inside Docker.

# --- PostgreSQL (TimescaleDB + pgvector) -------------------------------------
DB_USER=crypto
DB_PASSWORD=change_me
DB_NAME=crypto_rag
# Host port; 5433 so it does not clash with a local Postgres on 5432.
DB_HOST_PORT=5433
# Used by code running on the host (migrations, CLI, tests).
# Inside compose the services override it with host "db" and port 5432.
DATABASE_URL=postgresql+psycopg://crypto:change_me@localhost:5433/crypto_rag
TEST_DATABASE_URL=postgresql+psycopg://crypto:change_me@localhost:5433/crypto_rag_test

# --- API keys ----------------------------------------------------------------
OPENAI_API_KEY=
GUARDIAN_API_KEY=

# --- OpenAI models -----------------------------------------------------------
# Router and news labelling
ROUTER_MODEL=gpt-5.6-luna
LABEL_MODEL=gpt-5.6-luna
# Answer generation
GENERATOR_MODEL=gpt-5.6-terra
# Evaluation judge: must be stronger than, and different from, the generator
JUDGE_MODEL=gpt-5.6-sol
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# --- Retrieval -----------------------------------------------------------------
DECAY_HALF_LIFE_HOURS=48

LOG_LEVEL=INFO
